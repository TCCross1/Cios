# CIOS Environment Configuration Example
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# Never commit a real `.env` file. `.env` is already ignored via .gitignore.
#
# This Directive 001 baseline does not implement any real integrations
# (no auth, no database, no AI providers). The variables below are
# placeholders establishing the convention for future directives.

# Runtime environment. One of: development | test | production
NODE_ENV=development

# Port used by future local dev servers (not currently consumed by any code).
PORT=3000

# --- Naming convention for future variables ---
# Public/browser-exposed variables (safe to ship to the client) MUST be
# prefixed, e.g. NEXT_PUBLIC_ / VITE_ / PUBLIC_, depending on the framework
# chosen in a later directive.
#
# Server-only secrets (API keys, database credentials, etc.) MUST NEVER use
# a public prefix and MUST NEVER be committed to this repository.
